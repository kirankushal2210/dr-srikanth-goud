{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm --filter @workspace/srikanth-goud run build",
  "outputDirectory": "artifacts/srikanth-goud/dist/public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
